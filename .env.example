# Copie ce fichier en ".env" et renseigne ta clé.
# Récupère-la gratuitement sur https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optionnel : URL d'un backend déployé (Render, Railway...). Si renseignée,
# l'app passe par ce backend au lieu d'appeler Gemini directement.
BACKEND_URL=

# Connexion Google (facultatif) — module natif Google Sign-In.
# Cree TROIS identifiants OAuth sur https://console.cloud.google.com/apis/credentials :
#   - type "Web application"  -> GOOGLE_WEB_CLIENT_ID   (obligatoire, meme sur mobile :
#     c'est lui qui delivre le jeton d'identite valable sur toutes les plateformes.
#     Aucun secret a coller ici, seul l'identifiant public est utilise.)
#   - type "iOS"               -> GOOGLE_IOS_CLIENT_ID   (bundle id : com.tonnom.bodyai)
#   - type "Android"           -> GOOGLE_ANDROID_CLIENT_ID (package + empreinte SHA-1
#     de la build ; visible avec `eas credentials`)
# Necessite une build de developpement (EAS Build) : ce module est absent d'Expo Go.
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# Serveur de paiement par carte (backend). Vide = abonnement active localement.
# Exemple en developpement : http://192.168.1.10:3000  |  en production : https://api.tondomaine.com
PAYMENTS_URL=
