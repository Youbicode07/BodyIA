# Copie ce fichier en ".env" et renseigne ta clé.
# Récupère-la gratuitement sur https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optionnel : URL d'un backend déployé (Render, Railway...). Si renseignée,
# l'app passe par ce backend au lieu d'appeler Gemini directement.
BACKEND_URL=

# Connexion Google (facultatif) — module natif Google Sign-In.
# Cree TROIS identifiants OAuth sur https://console.cloud.google.com/apis/credentials :
#   - type "Web application"  -> GOOGLE_WEB_CLIENT_ID   (obligatoire, meme sur mobile :
#     c'est lui qui delivre le jeton d'identite valable sur toutes les plateformes.
#     Aucun secret a coller ici, seul l'identifiant public est utilise.)
#   - type "iOS"               -> GOOGLE_IOS_CLIENT_ID   (bundle id : com.tonnom.bodyai)
#   - type "Android"           -> GOOGLE_ANDROID_CLIENT_ID (package + empreinte SHA-1
#     de la build ; visible avec `eas credentials`)
# Necessite une build de developpement (EAS Build) : ce module est absent d'Expo Go.
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# --- Serveur BodyAI (comptes, base de donnees, abonnement) -----------------
# Adresse du backend (dossier backend/). C'est LUI qui stocke les comptes et
# toutes les donnees utilisateur, et qui encaisse les abonnements.
#
# Vide = l'application fonctionne, mais uniquement en local sur le telephone :
#        pas de compte durable, pas de transfert vers un autre appareil, pas
#        d'abonnement encaissable. L'application le dit clairement plutot que
#        de faire semblant.
#
#   developpement : le telephone doit joindre ta machine. Utilise l'IP du
#                   reseau local (http://192.168.1.10:3000) ou un tunnel
#                   (ngrok http 3000) -- "localhost" designe le telephone
#                   lui-meme et ne fonctionnera jamais.
#   production    : https://api.tondomaine.com
API_URL=

# --- Paiement par carte ---------------------------------------------------
# Adresse du backend (dossier backend/) qui cree et VERIFIE les sessions de
# paiement. Vide = l'ecran d'abonnement s'affiche mais annonce clairement que
# le paiement n'est pas branche : il n'active jamais un abonnement sans
# encaissement reel.
#
#   developpement : le telephone doit joindre ta machine. Utilise l'IP du
#                   reseau local (http://192.168.1.10:3000) ou un tunnel
#                   (ngrok http 3000) -- "localhost" designe le telephone
#                   lui-meme et ne fonctionnera jamais.
#   production    : https://api.tondomaine.com
#
# Laisse vide si API_URL est renseignee : c'est le meme serveur.
#
# Cote serveur, renseigne en plus backend/.env :
#   DATABASE_URL    PostgreSQL en production (sinon SQLite local)
#   SESSION_SECRET  secret de signature des sessions (obligatoire en prod)
#   GOOGLE_WEB_CLIENT_ID  pour que le serveur puisse verifier les jetons Google
#   PUBLIC_URL      adresse publique du backend (page de retour du paiement)
#   PAYMENT_CURRENCY / PLAN_MONTHLY_AMOUNT / PLAN_YEARLY_AMOUNT
#   CMI_CLIENT_ID + CMI_STORE_KEY  (Maroc)  ou  STRIPE_SECRET_KEY (international)
PAYMENTS_URL=
