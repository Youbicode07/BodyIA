# ==========================================================================
#  ATTENTION : NE METS PAS TA CLE ICI.
#
#  Ce fichier est un MODELE, suivi par git : tout ce que tu y écris finirait
#  publié si tu partages le projet. Ta vraie clé va dans "backend/.env"
#  (déjà créé, ignoré par git).
#
#  Et de toute façon, l'app n'a plus besoin de ce backend : elle appelle
#  Gemini directement avec la clé du fichier ".env" à la racine du projet.
#  Ce backend ne sert que si tu veux un jour le déployer en ligne.
# ==========================================================================

GEMINI_API_KEY=

# Optionnel : port d'écoute du serveur (par défaut 3000)
PORT=3000

# Optionnel : force un modèle Gemini précis pour tout (corps + repas).
# Laisse vide pour garder le défaut (gemini-3.5-flash, le plus fiable mesuré).
# GEMINI_MODEL=

# Optionnel : override indépendant par usage.
# GEMINI_BODY_MODEL=gemini-3.5-flash
# GEMINI_MEAL_MODEL=gemini-3.5-flash

# --- Base de donnees -------------------------------------------------------
# Vide  = SQLite dans backend/data/bodyai.db (developpement, zero installation,
#         SQLite est integre a Node 22+).
# Rempli = PostgreSQL. OBLIGATOIRE en production : le disque d'une instance
#         gratuite Render est efface a chaque redeploiement, une base SQLite y
#         disparaitrait avec tous les comptes.
#
# OFFRE GRATUITE RECOMMANDEE : Neon (https://neon.com)
#   - gratuit de facon PERMANENTE, 0,5 Go, sans carte bancaire ;
#   - cree un projet, copie la "connection string" et colle-la ci-dessous.
#
# A EVITER : la base PostgreSQL gratuite de Render. Elle EXPIRE 30 jours apres
# sa creation et est ensuite SUPPRIMEE avec toutes ses lignes.
# Supabase fonctionne aussi, mais met le projet en PAUSE apres 7 jours sans
# activite (10 a 30 secondes pour le reveiller).
#
# Exemple :
# DATABASE_URL=postgresql://user:motdepasse@ep-xxx.eu-central-1.aws.neon.tech/bodyai?sslmode=require
DATABASE_URL=

# --- Sessions --------------------------------------------------------------
# Secret de signature des jetons de session. OBLIGATOIRE en production :
# sans lui un secret temporaire est genere au demarrage, et TOUS les
# utilisateurs sont deconnectes a chaque redeploiement.
# Genere-le avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Connexion Google / Apple ----------------------------------------------
# Le serveur verifie lui-meme les jetons d'identite. Il doit connaitre les
# identifiants clients acceptes, sinon tout jeton est refuse (un jeton emis
# pour une autre application ne doit jamais ouvrir de session ici).
# Ce sont les MEMES valeurs que dans le .env de l'application.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# Identifiant de l'app iOS, pour « Se connecter avec Apple ».
APPLE_BUNDLE_ID=com.bodyai.app

# --- Paiement par carte ---------------------------------------------------
# Prestataire a utiliser. Vide = le premier dont les cles sont renseignees.
PAYMENT_PROVIDER=
# Devise des prix (eur, mad, usd...).
PAYMENT_CURRENCY=eur
# Adresse PUBLIQUE de ce serveur, utilisee comme page de retour du paiement.
# Doit etre joignable depuis le telephone (ngrok en dev, domaine en prod).
PUBLIC_URL=
# Stripe (international - N'ACCEPTE PAS les entreprises marocaines).
STRIPE_SECRET_KEY=
# CMI - Centre Monetique Interbancaire (Maroc).
# Fournis par ta banque lors de l'ouverture du contrat e-commerce.
CMI_CLIENT_ID=
CMI_STORE_KEY=
# Laisse vide pour la passerelle de production. Pour les tests, ta banque
# fournit une adresse de preproduction a mettre ici.
CMI_GATEWAY_URL=
# Prix, dans la plus petite unite de la devise (99,00 MAD = 9900).
PLAN_MONTHLY_AMOUNT=
PLAN_YEARLY_AMOUNT=
